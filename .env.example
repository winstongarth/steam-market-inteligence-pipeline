# Copy to .env and adjust. Never commit .env — see .gitignore.

# Rate limiting (Phase 0 measured; see docs/PHASE0_FINDINGS.md)
STEAM_RPS=0.5
STEAM_USER_AGENT=steam-market-pipeline/0.1 (personal research project; contact: winstonpatrickgarth@gmail.com)

# Kafka (Redpanda) — local dev via docker-compose
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# S3 (MinIO) — local dev via docker-compose
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=steam-lake
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Dashboard (Grafana + postgres-marts) — local dev via docker-compose
# Host-side scripts (uv run python -m analytics.export_to_grafana) hit the published
# 5433 port; inside docker-compose, the Airflow DAG's sync_dashboard task overrides this
# to the in-network postgres-marts:5432 host — see docker-compose.yml's airflow-env.
GRAFANA_POSTGRES_URL=postgresql+psycopg2://marts:marts@localhost:5433/marts
GRAFANA_ADMIN_PASSWORD=admin
# Comma-separated app_ids to sync to the dashboard; default is CS2 only. Unset (empty) to
# sync every tracked game (ingest/config.py APP_IDS) instead.
DASHBOARD_APP_IDS=730
