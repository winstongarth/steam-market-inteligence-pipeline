# Copy to .env and adjust. Never commit .env — see .gitignore.

# Rate limiting (Phase 0 measured; see docs/PHASE0_FINDINGS.md)
STEAM_RPS=0.5
STEAM_USER_AGENT=steam-market-pipeline/0.1 (personal research project; contact: winstonpatrickgarth@gmail.com)

# Kafka (Redpanda) — local dev via docker-compose
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# S3 (MinIO) — local dev via docker-compose
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=steam-lake
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
